# NASA FIRMS API Key (required for both Track A and Track B)
# Register at: https://firms.modaps.eosdis.nasa.gov/api/area/
MAP_KEY=your_firms_map_key_here

# Sentinel Hub credentials (optional - required only for Track B imagery fetch)
# Register at: https://www.sentinel-hub.com/
SENTINELHUB_CLIENT_ID=your_sentinelhub_client_id_here
SENTINELHUB_CLIENT_SECRET=your_sentinelhub_client_secret_here

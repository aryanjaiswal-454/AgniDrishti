# ==================================================
# AgniDrishti Classifier Service — Environment Configuration
# ==================================================

# Service Configuration
CLASSIFIER_PORT=8000
CLASSIFIER_HOST=0.0.0.0

# Track A Configuration
TRACK_A_MODEL_PATH=../../data/sample/models/track_a_ml_v1_0.joblib
TRACK_A_WORLDCOVER_PATH=../../data/raw/worldcover/tiles/

# Track B Configuration
# Required in production: Track B queries live hotspots and facilities from
# PostGIS. Use the production database connection; never commit its value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Optional legacy/sample artifacts for offline development only.
TRACK_B_CONTRACT_PATH=../../data/sample/processed/track_b_b4_contract_ready.jsonl
TRACK_B_OSM_FACILITIES_PATH=../../data/sample/input/osm_facilities_thoothukudi_2025q4.json

# Logging
LOG_LEVEL=INFO

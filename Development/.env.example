# ==================================================
# AgniDrishti — Environment Configuration
# ==================================================
# Copy this file to .env and fill in the values.
# Do NOT commit your .env file.

# --------------------------------------------------
# API Server
# --------------------------------------------------
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --------------------------------------------------
# Database (PostgreSQL + PostGIS)
# --------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agnidrishti
POSTGRES_USER=agnidrishti
POSTGRES_PASSWORD=agnidrishti_dev
DATABASE_URL=postgresql://agnidrishti:agnidrishti_dev@localhost:5432/agnidrishti

# --------------------------------------------------
# Redis (Queues & Caching)
# --------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --------------------------------------------------
# JWT Authentication
# --------------------------------------------------
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
JWT_EXPIRES_IN=7d

# --------------------------------------------------
# NASA FIRMS Ingestion
# --------------------------------------------------
FIRMS_MAP_KEY=your_firms_map_key_here
FIRMS_SOURCE=VIIRS_SNPP_NRT,MODIS_NRT
# Area bounding box for India (minLon,minLat,maxLon,maxLat or W,S,E,N format used by FIRMS API)
FIRMS_AREA_COORDINATES=68,6,98,38
FIRMS_DAY_RANGE=1
FIRMS_POLL_INTERVAL=*/30 * * * *

# --------------------------------------------------
# OpenStreetMap (OSM) Overpass API Ingestion
# --------------------------------------------------
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_SYNC_INTERVAL=0 3 * * 0
# Bounding box for India in Overpass format: (south,west,north,east)
OSM_AREA_BBOX=6.5,68.0,37.5,97.5

# --------------------------------------------------
# AI/ML Classifier Service (future — Phase D7)
# --------------------------------------------------
CLASSIFIER_URL=http://localhost:8000

# --------------------------------------------------
# Frontend (Vite environment variables must start with VITE_)
# --------------------------------------------------
VITE_API_URL=http://localhost:3001
